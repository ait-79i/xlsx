# PostgreSQL connection string (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/excel_to_json?schema=public"

# Secret used to sign the session JWT. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"

# Session lifetime (jose format: 1h, 7d, ...)
JWT_EXPIRES_IN="1d"

# The session cookie is "Secure" (https only) in production. Set to false to serve the app over plain http.
# COOKIE_SECURE=false
